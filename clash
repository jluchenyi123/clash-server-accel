#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""
clash - Clash (mihomo) subscription manager for headless servers

Usage:
  clash                         Interactive menu
  clash add <url>               Add a subscription and enable it
  clash list                    List profiles/subscriptions
  clash use <name>              Switch to a profile
  clash update [name]           Update a subscription (default: active)
  clash nodes [--test]          Show nodes, latency and select a node
  clash status                  Show service and connectivity status
  clash start|stop|restart      Manage the proxy service
  clash logs [-f]               Show logs
  clash tun on|off|status       System-wide TUN mode (requires sudo)
  clash import-verge            Import subscriptions from Clash Verge
"""

